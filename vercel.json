{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter=@workspace/api-server build",
  "outputDirectory": ".",
  "public": false,
  "builds": [
    {
      "src": "artifacts/api-server/dist/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "artifacts/api-server/dist/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "artifacts/api-server/dist/index.mjs"
    }
  ],
  "env": {
    "PNPM_HOME": ".pnpm",
    "NODE_ENV": "production"
  }
}
