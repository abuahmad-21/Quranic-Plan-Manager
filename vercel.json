{
  "version": 2,
  "builds": [
    {
      "src": "quran-coach/public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/manifest.json", "dest": "/quran-coach/public/manifest.json" },
    { "src": "/(style\\.css.*|app\\.js.*|.*\\.png|.*\\.ico|.*\\.svg|.*\\.woff2?)", "dest": "/quran-coach/public/$1" },
    { "src": "/(.*)", "dest": "/quran-coach/public/index.html" }
  ]
}
